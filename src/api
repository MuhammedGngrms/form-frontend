import axios from 'axios';

console.log("Aktif Backend URL:", import.meta.env.VITE_API_URL);

const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:8080';

const api = axios.create({
  baseURL: API_URL, 
});

// Java'dan dönen cevapları kontrol et
api.interceptors.response.use(
  (response) => response,
  (error) => {
    // 1. Durum: Sunucu uykudaysa veya internet anlık koptuysa (Response yoksa)
    if (!error.response) {
      console.warn("Erişim aksaması: Sunucu geç yanıt veriyor veya ağ koptu.");
      // Kullanıcıyı dışarı ATMIYORUZ. Sadece toast mesajı gösterebilmek için hatayı fırlatıyoruz.
      return Promise.reject(new Error("Sunucuya şu an ulaşılamıyor, lütfen tekrar deneyin."));
    }

    // 2. Durum: YALNIZCA token süresi bittiyse (401) kullanıcıyı dışarı at
    if (error.response.status === 401) {
      console.error("Oturum süresi doldu (401). Login'e yönlendiriliyorsunuz.");
      localStorage.removeItem('seba_user');
      window.location.href = '/login';
      return Promise.reject(error);
    }

    // 3. Durum: Yetki hatası (403) varsa kullanıcıyı sistemden ATMA, sadece sayfayı engelle
    if (error.response.status === 403) {
      console.warn("Yetkisiz alan (403): Kullanıcı içeride kalmaya devam ediyor.");
      return Promise.reject(error);
    }

    // Diğer tüm hatalarda (500, 404 vb.) kullanıcıyı içeride tut
    return Promise.reject(error);
  }
);

export default api;